{
  "name": "investment-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "setup": "npm install",
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server",
    "test": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

